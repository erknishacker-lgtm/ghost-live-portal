generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // "native" keeps local dev (macOS) working; the musl target matches
  // node:20-alpine's OpenSSL 3.x, which is what the Docker image runs on.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// -----------------------------------------------------------------------
// Portal accounts
// -----------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.Citext
  passwordHash String?  @map("password_hash")
  name         String?
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  licenses             License[]
  portalSessions       PortalSession[]
  passwordSetTokens    PasswordSetToken[]
  notificationPrefs    NotificationPreference?

  @@map("users")
}

model PortalSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portal_sessions")
}

model PasswordSetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_set_tokens")
}

// -----------------------------------------------------------------------
// Licensing
// -----------------------------------------------------------------------

enum LicenseStatus {
  active
  expired
  suspended
  revoked
}

model License {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  licenseKey           String        @unique @map("license_key")
  plan                 String
  // Snapshotted at purchase time from the plan catalog (lib/billing/plans.ts)
  // so a later change to a plan's limits never retroactively affects an
  // already-sold license.
  maxDevices           Int           @default(1) @map("max_devices")
  status               LicenseStatus @default(active)
  expiresAt            DateTime?     @map("expires_at")
  features             Json          @default("{}")
  stripeCustomerId     String?       @map("stripe_customer_id")
  stripeSubscriptionId String?       @map("stripe_subscription_id")
  activatedAt          DateTime?     @map("activated_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices  LicenseDevice[]
  saleEvents  SaleEvent[]
  activity LicenseActivity[]

  @@index([userId])
  @@map("licenses")
}

model LicenseDevice {
  id                    String    @id @default(uuid())
  licenseId             String    @map("license_id")
  deviceId              String    @map("device_id")
  deviceName            String?   @map("device_name")
  platform              String?
  lastAppVersion        String?   @map("last_app_version")
  lastExtensionVersion  String?   @map("last_extension_version")
  sessionTokenHash      String    @unique @map("session_token_hash")
  sessionExpiresAt      DateTime  @map("session_expires_at")
  // Set via chrome.runtime.setUninstallURL — Chrome opens this URL as a plain
  // GET navigation on uninstall, so it carries its own single-purpose token
  // rather than the session bearer token (never exposed in browser history/logs).
  uninstallTokenHash    String?   @unique @map("uninstall_token_hash")
  activatedAt           DateTime  @default(now()) @map("activated_at")
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  // One license can hold multiple devices (up to license.maxDevices), but
  // never the same physical device twice.
  @@unique([licenseId, deviceId])
  @@map("license_devices")
}

model LicenseActivity {
  id        String   @id @default(uuid())
  licenseId String?  @map("license_id")
  eventType String   @map("event_type")
  detail    Json      @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@map("license_activity_log")
}

model SaleEvent {
  id            String   @id @default(uuid())
  licenseId     String   @map("license_id")
  eventId       String   @unique @map("event_id")
  eventType     String   @map("event_type")
  amountCents   Int      @map("amount_cents")
  currency      String   @default("BRL")
  productId     String?  @map("product_id")
  productName   String?  @map("product_name")
  quantity      Int      @default(1)
  occurredAt    DateTime @map("occurred_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  createdAt     DateTime @default(now()) @map("created_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, occurredAt])
  @@map("sale_events")
}

model NotificationPreference {
  userId              String   @id @map("user_id")
  receiveNotifications Boolean @default(true) @map("receive_notifications")
  showValue           Boolean  @default(true) @map("show_value")
  showProduct         Boolean  @default(true) @map("show_product")
  showQuantity        Boolean  @default(true) @map("show_quantity")
  soundEnabled        Boolean  @default(true) @map("sound_enabled")
  vibrationEnabled    Boolean  @default(true) @map("vibration_enabled")
  notifyRefund        Boolean  @default(true) @map("notify_refund")
  notifyChargeback    Boolean  @default(true) @map("notify_chargeback")
  updateBadge         Boolean  @default(true) @map("update_badge")
  volume              Int      @default(100)
  timezone            String   @default("America/Sao_Paulo")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stripe_webhook_events")
}

model SystemFlag {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_flags")
}

// -----------------------------------------------------------------------
// Extension distribution (admin-uploaded .zip, served to logged-in users)
// -----------------------------------------------------------------------

model ExtensionRelease {
  id             String   @id @default(uuid())
  version        String
  filename       String
  sizeBytes      Int      @map("size_bytes")
  // Stored straight in Postgres (bytea) instead of a filesystem/volume —
  // one small admin-uploaded file, and the DB is already the one thing in
  // this stack with real persistence sorted out.
  data           Bytes
  uploadedByUserId String? @map("uploaded_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("extension_releases")
}
