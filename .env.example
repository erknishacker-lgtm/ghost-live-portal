# Postgres connection string (EasyPanel's Postgres service, or local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghost_live_portal?schema=public"

# Public base URL of this app (used to build email links, Stripe redirect URLs)
APP_BASE_URL="http://localhost:3000"

# Stripe — assinatura mensal (Checkout mode=subscription)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Um price ID (recorrência mensal) por plano, ver lib/billing/plans.ts
STRIPE_PRICE_ID_STARTER_1="price_..."         # R$97 — 1 conta TikTok
STRIPE_PRICE_ID_STARTER_2="price_..."         # R$147 — 2 contas TikTok
STRIPE_PRICE_ID_STARTER_UNLIMITED="price_..." # R$297 — contas ilimitadas

# Transactional email (Resend) — used for the "set your password" link sent
# after a Stripe purchase, and as a fallback if you want to resend a license key.
RESEND_API_KEY="re_..."
EMAIL_FROM="Ghost Live <no-reply@louzadadigitalhub.com>"

NODE_ENV="development"
PORT=3000
